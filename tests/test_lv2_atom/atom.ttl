@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://ampforge.org/plugins/test-atom>
    a lv2:Plugin ;
    doap:name "AmpForge Test Atom" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:port [
        a lv2:AudioPort ,
            lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort ,
            lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a atom:AtomPort ,
            lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "events" ;
        lv2:name "Events" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] , [
        a atom:AtomPort ,
            lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "events_out" ;
        lv2:name "Events Out" ;
        atom:bufferType atom:Sequence
    ] .
